# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
NEXT_PUBLIC_SITE_URL=https://bdjphysiq.com

# Shared secret between the Sanity webhook and /api/revalidate.
# Generate one with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=replace-with-a-long-random-string

# ---- Live database and AI assistant (all optional; the site works without them) ----
# Postgres connection string from Neon or Supabase. Run db/schema.sql once.
DATABASE_URL=
# Enables the "Ask us" assistant. Set a monthly spending limit in the Anthropic console.
ANTHROPIC_API_KEY=
# Optional: model (default is the low-cost claude-haiku-4-5-20251001) and daily message cap.
ANTHROPIC_MODEL=
ASSISTANT_DAILY_LIMIT=400
# Optional: random string used to hash visitor IP addresses before storage.
IP_HASH_SALT=
# Optional email alert for new leads (resend.com, free tier).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
